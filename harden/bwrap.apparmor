# AppArmor profile: grant ONLY /usr/bin/bwrap the right to create
# unprivileged user namespaces, while keeping Ubuntu's host-wide
# kernel.apparmor_restrict_unprivileged_userns=1 in place.
#
# Install:
#   sudo install -m 0644 -b harden/bwrap.apparmor /etc/apparmor.d/bwrap
#   sudo apparmor_parser -r /etc/apparmor.d/bwrap
#
# The profile is unconfined (it does NOT restrict bwrap's powers) -- its only
# effect is the "userns," rule, which whitelists the binary against the
# Ubuntu 24.10+/26.04 unprivileged-userns restriction.

abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/bwrap>
}
